# Copier en .env et renseigner. Ne jamais committer le .env réel.

# --- Base de données ---
DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/vitals?schema=public"

# --- Authentification ---
# Générer une valeur aléatoire par environnement :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="a-remplacer-par-un-secret-aleatoire"
JWT_REFRESH_SECRET="a-remplacer-par-un-autre-secret-aleatoire"

# Access court : limite la fenêtre d'exploitation d'un jeton volé.
JWT_ACCESS_TTL="15m"
# Refresh long : un agent peut rester des semaines sans réseau et doit
# pouvoir resynchroniser sans repasser par une saisie de mot de passe.
JWT_REFRESH_TTL="30d"

# --- Serveur ---
PORT=3000
NODE_ENV=development

# Origines autorisées, séparées par des virgules. Vide = aucune origine
# navigateur autorisée (l'application mobile n'est pas soumise au CORS).
CORS_ORIGINS=""
