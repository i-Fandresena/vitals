# Configuration du déploiement. Copier en .env sur le VPS.
# Ce fichier ne doit JAMAIS être commité une fois rempli.

# --- Domaines ---
# Doivent pointer en A vers l'IP du VPS AVANT le premier démarrage :
# Traefik demande les certificats à Let's Encrypt, qui doit résoudre les noms.
API_DOMAIN=api-vitals.aura-plus.site
ADMIN_DOMAIN=vitals.aura-plus.site

# --- Base de données ---
POSTGRES_USER=vitals
POSTGRES_DB=vitals
# Générer : openssl rand -base64 36
POSTGRES_PASSWORD=

# --- Authentification ---
# Deux secrets DISTINCTS. Générer chacun avec :
#   openssl rand -base64 48 | tr -d '\n'
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Remontée DHIS2 (facultative) ---
# Laisser vide tant que le rapprochement avec le ministère n'est pas fait :
# l'espace d'administration affiche alors « non configuré » plutôt que
# d'échouer à l'envoi.
#
# Serveur de démonstration pour les essais :
#   DHIS2_URL=https://play.im.dhis2.org/stable-2-43-1
#   DHIS2_USERNAME=admin
#   DHIS2_PASSWORD=district
#
# ⚠️ Ne jamais pointer un serveur de démonstration avec des données réelles :
# play.dhis2.org est public et réinitialisé régulièrement.
DHIS2_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
