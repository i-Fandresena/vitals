# Configuration du déploiement. Copier en .env sur le VPS.
# Ce fichier ne doit JAMAIS être commité une fois rempli.

# --- Domaines ---
API_DOMAIN=api-vitals.aura-plus.site
ADMIN_DOMAIN=vitals.aura-plus.site

# Adresse utilisée par Let's Encrypt pour prévenir d'un problème de certificat.
ACME_EMAIL=

# --- Base de données ---
POSTGRES_USER=vitals
POSTGRES_DB=vitals
# Générer : openssl rand -base64 36
POSTGRES_PASSWORD=

# --- Authentification ---
# Deux secrets DISTINCTS. Générer chacun avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
